+// OIDCTokens exposes retained provider credentials only to trusted in-process
+// middleware. The interface lets consumers also work with unpatched versions
+// of caddy-oidc, where token retention is unavailable.
+func (s *Session) OIDCTokens() (accessToken, idToken string) {
+	return s.AccessToken, s.IDToken
 }
 
