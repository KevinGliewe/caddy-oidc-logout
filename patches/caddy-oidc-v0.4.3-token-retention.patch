diff --git a/authenticator/cookie_retention_test.go b/authenticator/cookie_retention_test.go
new file mode 100644
index 0000000..35f1b83
--- /dev/null
+++ b/authenticator/cookie_retention_test.go
@@ -0,0 +1,174 @@
+package authenticator
+
+import (
+	"context"
+	"encoding/base64"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/caddyserver/caddy/v2"
+	"github.com/caddyserver/caddy/v2/caddyconfig/caddyfile"
+	"github.com/caddyserver/certmagic"
+	"github.com/relvacode/caddy-oidc/internal/pkgtest"
+	"github.com/relvacode/caddy-oidc/session"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/oauth2"
+)
+
+type retainedTokenConfiguration struct {
+	testHandleCallbackConfiguration
+	token *oauth2.Token
+}
+
+func (cfg *retainedTokenConfiguration) Exchange(context.Context, string, ...oauth2.AuthCodeOption) (*oauth2.Token, error) {
+	return cfg.token, nil
+}
+
+func retainedFixture(t *testing.T, retain bool, maxAge time.Duration, tokenExpiry, idExpiry time.Time) (*SessionCookieAuthenticator, *retainedTokenConfiguration) {
+	t.Helper()
+	au := &SessionCookieAuthenticator{
+		Name: "caddy", Secret: strings.Repeat("s", 64),
+		RetainAccessToken: retain, MaxAge: caddy.Duration(maxAge),
+		IDClaims:     []string{"iss", "sub", "exp"},
+		tokenStorage: &certmagic.FileStorage{Path: t.TempDir()},
+	}
+	ctx, cancel := caddy.NewContext(caddy.Context{Context: context.Background()})
+	t.Cleanup(cancel)
+	require.NoError(t, au.Provision(ctx))
+	cfg := &retainedTokenConfiguration{
+		testHandleCallbackConfiguration: testHandleCallbackConfiguration{
+			userInfo: newTestUserInfo(t, `{"sub":"test"}`),
+		},
+		token: (&oauth2.Token{AccessToken: "original.access.jwt", TokenType: "Bearer", Expiry: tokenExpiry}).WithExtra(map[string]any{
+			"id_token": pkgtest.GenerateTestJWTExpiresAt(idExpiry),
+		}),
+	}
+	return au, cfg
+}
+
+func TestRetainedCredentialsAreOptionalAndBoundToTokenExpiry(t *testing.T) {
+	now := (&pkgtest.TestOIDCConfiguration{}).Now()
+	for _, tt := range []struct {
+		name                                 string
+		retain                               bool
+		maxAge, accessLife, idLife, wantLife time.Duration
+	}{
+		{"default discards credentials", false, 0, time.Minute, time.Hour, time.Hour},
+		{"access expiry", true, 0, time.Minute, time.Hour, time.Minute},
+		{"ID expiry", true, 0, time.Hour, time.Minute, time.Minute},
+		{"max age cannot extend token", true, 24 * time.Hour, time.Minute, time.Hour, time.Minute},
+		{"max age can shorten token", true, time.Minute, time.Hour, time.Hour, time.Minute},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			au, cfg := retainedFixture(t, tt.retain, tt.maxAge, now.Add(tt.accessLife), now.Add(tt.idLife))
+			s, err := au.handleCodeExchange(cfg, pkgtest.NewRequest(http.MethodGet, "/oauth2/callback?code=code", nil), "verifier")
+			require.NoError(t, err)
+			require.Equal(t, now.Add(tt.wantLife).Unix(), s.ExpiresAt)
+			if tt.retain {
+				require.Equal(t, cfg.token.AccessToken, s.AccessToken)
+				require.Equal(t, cfg.token.Extra("id_token"), s.IDToken)
+				require.NoError(t, au.storeRetainedTokens(context.Background(), s, now))
+				encoded, err := au.secure.Encode(au.Name, s)
+				require.NoError(t, err)
+				require.NotContains(t, encoded, s.AccessToken)
+				r := pkgtest.NewRequest(http.MethodGet, "/", nil)
+				r.AddCookie(au.NewCookie(encoded))
+				restored, err := au.AuthenticateRequest(cfg, r)
+				require.NoError(t, err)
+				require.Equal(t, s.AccessToken, restored.AccessToken)
+				require.Equal(t, s.IDToken, restored.IDToken)
+			} else {
+				require.Empty(t, s.AccessToken)
+				require.Empty(t, s.IDToken)
+			}
+			require.NotContains(t, string(s.Claims), "original.access.jwt")
+		})
+	}
+}
+
+func TestRetainedCredentialsRejectUnusableAccessTokens(t *testing.T) {
+	now := (&pkgtest.TestOIDCConfiguration{}).Now()
+	for _, tc := range []struct {
+		name   string
+		mutate func(*oauth2.Token)
+	}{
+		{"missing", func(t *oauth2.Token) { t.AccessToken = "" }},
+		{"header injection", func(t *oauth2.Token) { t.AccessToken = "token\r\nX-Injected: true" }},
+		{"non bearer", func(t *oauth2.Token) { t.TokenType = "MAC" }},
+		{"unknown expiry", func(t *oauth2.Token) { t.Expiry = time.Time{} }},
+		{"expired", func(t *oauth2.Token) { t.Expiry = now }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			au, cfg := retainedFixture(t, true, 0, now.Add(time.Hour), now.Add(time.Hour))
+			tc.mutate(cfg.token)
+			_, err := au.handleCodeExchange(cfg, pkgtest.NewRequest(http.MethodGet, "/", nil), "v")
+			require.Error(t, err)
+		})
+	}
+}
+
+func TestRetainedCredentialsRejectExpiryWithoutCookieLeeway(t *testing.T) {
+	now := (&pkgtest.TestOIDCConfiguration{}).Now()
+	au, cfg := retainedFixture(t, true, 0, now.Add(time.Hour), now.Add(time.Hour))
+	for _, s := range []*session.Session{
+		{UID: "test", AccessToken: "token", IDToken: "id", ExpiresAt: now.Unix()},
+		{UID: "test", AccessToken: "token", IDToken: "id", ExpiresAt: now.Add(-time.Second).Unix()},
+		{UID: "test", ExpiresAt: now.Add(time.Hour).Unix()},
+	} {
+		encoded, err := au.secure.Encode(au.Name, s)
+		require.NoError(t, err)
+		r := pkgtest.NewRequest(http.MethodGet, "/", nil)
+		r.AddCookie(au.NewCookie(encoded))
+		_, err = au.AuthenticateRequest(cfg, r)
+		require.Error(t, err)
+	}
+}
+
+func TestDisablingRetentionHidesPreviouslyStoredCredentials(t *testing.T) {
+	now := (&pkgtest.TestOIDCConfiguration{}).Now()
+	au, cfg := retainedFixture(t, false, 0, now.Add(time.Hour), now.Add(time.Hour))
+	encoded, err := au.secure.Encode(au.Name, &session.Session{UID: "test", AccessToken: "token", IDToken: "id", ExpiresAt: now.Add(time.Hour).Unix()})
+	require.NoError(t, err)
+	r := pkgtest.NewRequest(http.MethodGet, "/", nil)
+	r.AddCookie(au.NewCookie(encoded))
+	s, err := au.AuthenticateRequest(cfg, r)
+	require.NoError(t, err)
+	require.Empty(t, s.AccessToken)
+	require.Empty(t, s.IDToken)
+}
+
+func TestOversizedRetainedTokenCannotCreateSession(t *testing.T) {
+	now := (&pkgtest.TestOIDCConfiguration{}).Now()
+	au, cfg := retainedFixture(t, true, 0, now.Add(time.Hour), now.Add(time.Hour))
+	cfg.token.AccessToken = strings.Repeat("x", 65536)
+	state := "oversized"
+	csrfValue, err := au.secure.Encode(au.Name+"|"+state, &CSRFToken{PKCEVerifier: "verifier", RedirectURI: "/"})
+	require.NoError(t, err)
+	r := pkgtest.NewRequest(http.MethodGet, "/oauth2/callback?state="+state+"&code=code", nil)
+	r.AddCookie(&http.Cookie{Name: au.Name + "|" + state, Value: csrfValue})
+	w := httptest.NewRecorder()
+	require.Error(t, au.HandleCallback(cfg, w, r))
+	for _, c := range w.Result().Cookies() {
+		require.NotEqual(t, au.Name, c.Name)
+	}
+}
+
+func TestRetainAccessTokenCaddyfile(t *testing.T) {
+	var au SessionCookieAuthenticator
+	require.NoError(t, au.UnmarshalCaddyfile(caddyfile.NewTestDispenser("{\n retain_access_token\n}")))
+	require.True(t, au.RetainAccessToken)
+	require.Error(t, au.UnmarshalCaddyfile(caddyfile.NewTestDispenser("{\n retain_access_token unexpected\n}")))
+}
+
+func TestAccessJWTAbsoluteExpiryCapsOAuthRelativeExpiry(t *testing.T) {
+	now := (&pkgtest.TestOIDCConfiguration{}).Now()
+	au, cfg := retainedFixture(t, true, 0, now.Add(time.Hour), now.Add(time.Hour))
+	cfg.token.AccessToken = "header." + base64.RawURLEncoding.EncodeToString([]byte(fmt.Sprintf(`{"exp":%d}`, now.Add(time.Minute).Unix()))) + ".signature"
+	s, err := au.handleCodeExchange(cfg, pkgtest.NewRequest(http.MethodGet, "/", nil), "v")
+	require.NoError(t, err)
+	require.Equal(t, now.Add(time.Minute).Unix(), s.ExpiresAt)
+}
diff --git a/authenticator/token_store.go b/authenticator/token_store.go
new file mode 100644
index 0000000..b41dc6e
--- /dev/null
+++ b/authenticator/token_store.go
@@ -0,0 +1,177 @@
+package authenticator
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io/fs"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/relvacode/caddy-oidc/session"
+)
+
+const maxRetainedTokenRecordSize = 64 << 10
+
+type retainedTokenRecord struct {
+	AccessToken    string `json:"access_token"`
+	IDToken        string `json:"id_token"`
+	ExpiresAt      int64  `json:"expires_at"`
+	SessionBinding string `json:"session_binding"`
+}
+
+func tokenSessionBinding(s *session.Session) (string, error) {
+	// json.Marshal compacts RawMessage, making the binding stable through the
+	// cookie JSON encode/decode round-trip. Include all authenticated claims.
+	b, err := json.Marshal(struct {
+		UID       string
+		ExpiresAt int64
+		Claims    json.RawMessage
+	}{s.UID, s.ExpiresAt, s.Claims})
+	if err != nil {
+		return "", err
+	}
+	digest := sha256.Sum256(b)
+	return hex.EncodeToString(digest[:]), nil
+}
+
+func (au *SessionCookieAuthenticator) tokenNamespace() string {
+	digest := sha256.Sum256([]byte(au.Name + "\x00" + au.Domain + "\x00" + au.Path))
+	return "oidc/retained_tokens/" + hex.EncodeToString(digest[:])
+}
+
+func (au *SessionCookieAuthenticator) tokenKey(s *session.Session) (string, error) {
+	ref, err := hex.DecodeString(s.TokenRef)
+	if err != nil || len(ref) != 32 || s.TokenRef != strings.ToLower(s.TokenRef) || s.ExpiresAt <= 0 {
+		return "", ErrNoAuthentication
+	}
+	return au.tokenNamespace() + "/" + strconv.FormatInt(s.ExpiresAt, 10) + "/" + s.TokenRef, nil
+}
+
+func (au *SessionCookieAuthenticator) tokenPurpose(s *session.Session) string {
+	return "oidc-retained|" + au.Name + "|" + s.TokenRef
+}
+
+func (au *SessionCookieAuthenticator) storeRetainedTokens(ctx context.Context, s *session.Session, now time.Time) error {
+	if au.tokenStorage == nil || au.tokenCodec == nil {
+		return errors.New("retained token storage is unavailable")
+	}
+	if s.AccessToken == "" || s.IDToken == "" || !s.Expires().After(now) {
+		return errors.New("retained tokens require valid credentials and expiry")
+	}
+	binding, err := tokenSessionBinding(s)
+	if err != nil {
+		return err
+	}
+	var reference [32]byte
+	if _, err := rand.Read(reference[:]); err != nil {
+		return err
+	}
+	s.TokenRef = hex.EncodeToString(reference[:])
+	key, err := au.tokenKey(s)
+	if err != nil {
+		return err
+	}
+	encoded, err := au.tokenCodec.Encode(au.tokenPurpose(s), retainedTokenRecord{
+		AccessToken: s.AccessToken, IDToken: s.IDToken,
+		ExpiresAt: s.ExpiresAt, SessionBinding: binding,
+	})
+	if err != nil {
+		return fmt.Errorf("cannot encode retained token record: %w", err)
+	}
+	storeCtx, cancel := context.WithTimeout(ctx, 10*time.Second)
+	defer cancel()
+	if err := au.tokenStorage.Store(storeCtx, key, []byte(encoded)); err != nil {
+		return err
+	}
+	au.cleanupRetainedTokens(ctx, now)
+	return nil
+}
+
+func (au *SessionCookieAuthenticator) loadRetainedTokens(ctx context.Context, s *session.Session, now time.Time) error {
+	if au.tokenStorage == nil || au.tokenCodec == nil {
+		return errors.New("retained token storage is unavailable")
+	}
+	key, err := au.tokenKey(s)
+	if err != nil {
+		return err
+	}
+	loadCtx, cancel := context.WithTimeout(ctx, 10*time.Second)
+	defer cancel()
+	encoded, err := au.tokenStorage.Load(loadCtx, key)
+	if err != nil {
+		if errors.Is(err, fs.ErrNotExist) {
+			return ErrNoAuthentication
+		}
+		return fmt.Errorf("cannot load retained token record: %w", err)
+	}
+	if len(encoded) > maxRetainedTokenRecordSize {
+		return ErrNoAuthentication
+	}
+	var record retainedTokenRecord
+	if au.tokenCodec.Decode(au.tokenPurpose(s), string(encoded), &record) != nil {
+		return ErrNoAuthentication
+	}
+	binding, err := tokenSessionBinding(s)
+	if err != nil {
+		return err
+	}
+	if record.AccessToken == "" || record.IDToken == "" || record.ExpiresAt != s.ExpiresAt || record.ExpiresAt <= now.Unix() || record.SessionBinding != binding {
+		return ErrNoAuthentication
+	}
+	s.AccessToken, s.IDToken = record.AccessToken, record.IDToken
+	return nil
+}
+
+func (au *SessionCookieAuthenticator) deleteRetainedTokens(ctx context.Context, s *session.Session) {
+	if au.tokenStorage == nil {
+		return
+	}
+	key, err := au.tokenKey(s)
+	if err != nil {
+		return
+	}
+	deleteCtx, cancel := context.WithTimeout(ctx, 2*time.Second)
+	defer cancel()
+	_ = au.tokenStorage.Delete(deleteCtx, key)
+}
+
+func (au *SessionCookieAuthenticator) cleanupRetainedTokens(ctx context.Context, now time.Time) {
+	// Cleanup is optional maintenance, never part of deciding authentication.
+	// Expiry checks remain mandatory even when no subsequent login cleans disk.
+	last := au.lastTokenCleanup.Load()
+	if now.Unix()-last < 60 || !au.lastTokenCleanup.CompareAndSwap(last, now.Unix()) {
+		return
+	}
+	cleanupCtx, cancel := context.WithTimeout(ctx, 2*time.Second)
+	defer cancel()
+	prefix := au.tokenNamespace()
+	buckets, err := au.tokenStorage.List(cleanupCtx, prefix, false)
+	if err != nil {
+		return
+	}
+	deleted := 0
+	for _, bucket := range buckets {
+		if deleted >= 128 || cleanupCtx.Err() != nil {
+			return
+		}
+		if !strings.HasPrefix(bucket, prefix+"/") {
+			continue
+		}
+		suffix := strings.TrimPrefix(bucket, prefix+"/")
+		if strings.Contains(suffix, "/") {
+			continue
+		}
+		expiry, err := strconv.ParseInt(suffix, 10, 64)
+		if err != nil || expiry > now.Unix() {
+			continue
+		}
+		_ = au.tokenStorage.Delete(cleanupCtx, prefix+"/"+strconv.FormatInt(expiry, 10))
+		deleted++
+	}
+}
