+	"github.com/relvacode/caddy-oidc/internal/pkgtest"
+	"github.com/relvacode/caddy-oidc/session"
+	"github.com/stretchr/testify/require"
+)
+
+func tokenStoreSession(now time.Time, uid string) *session.Session {
+	return &session.Session{UID: uid, Claims: json.RawMessage(`{"iss":"https://issuer","sid":"s","sub":"` + uid + `"}`),
+		ExpiresAt: now.Add(time.Hour).Unix(), AccessToken: strings.Repeat("access", 2000), IDToken: "original.id.jwt"}
+}
+
+func reloadedAuthenticator(t *testing.T, au *SessionCookieAuthenticator) *SessionCookieAuthenticator {
+	t.Helper()
+	next := &SessionCookieAuthenticator{Name: au.Name, Secret: au.Secret, Path: au.Path, Domain: au.Domain,
+		RetainAccessToken: true, tokenStorage: au.tokenStorage}
+	ctx, cancel := caddy.NewContext(caddy.Context{Context: context.Background()})
+	t.Cleanup(cancel)
+	require.NoError(t, next.Provision(ctx))
+	return next
+}
+
+func TestTokensPersistEncryptedOutsideCookieAcrossProvision(t *testing.T) {
+	now := (&pkgtest.TestOIDCConfiguration{}).Now()
+	au, cfg := retainedFixture(t, true, 0, now.Add(time.Hour), now.Add(time.Hour))
+	s := tokenStoreSession(now, "alice")
+	require.NoError(t, au.storeRetainedTokens(context.Background(), s, now))
+	require.Len(t, s.TokenRef, 64)
+	plainCookie, err := json.Marshal(s)
+	require.NoError(t, err)
+	require.NotContains(t, string(plainCookie), s.AccessToken)
+	require.NotContains(t, string(plainCookie), s.IDToken)
+	cookie, err := au.secure.Encode(au.Name, s)
+	require.NoError(t, err)
+	require.Less(t, len(cookie), 4096)
+	key, err := au.tokenKey(s)
+	require.NoError(t, err)
+	encrypted, err := au.tokenStorage.Load(context.Background(), key)
+	require.NoError(t, err)
+	require.NotContains(t, string(encrypted), s.AccessToken)
+	require.NotContains(t, string(encrypted), s.IDToken)
+	r := pkgtest.NewRequest(http.MethodGet, "/", nil)
+	r.AddCookie(au.NewCookie(cookie))
+	restored, err := reloadedAuthenticator(t, au).AuthenticateRequest(cfg, r)
+	require.NoError(t, err)
+	require.Equal(t, s.AccessToken, restored.AccessToken)
+	require.Equal(t, s.IDToken, restored.IDToken)
+}
+
+func TestTokenRecordCannotBeSwappedBetweenIdentities(t *testing.T) {
+	now := (&pkgtest.TestOIDCConfiguration{}).Now()
+	au, _ := retainedFixture(t, true, 0, now.Add(time.Hour), now.Add(time.Hour))
+	a, b := tokenStoreSession(now, "alice"), tokenStoreSession(now, "bob")
+	require.NoError(t, au.storeRetainedTokens(context.Background(), a, now))
+	require.NoError(t, au.storeRetainedTokens(context.Background(), b, now))
+	a.TokenRef = b.TokenRef
+	a.AccessToken, a.IDToken = "", ""
+	require.ErrorIs(t, au.loadRetainedTokens(context.Background(), a, now), ErrNoAuthentication)
+}
+
+func TestTamperedMissingRotatedAndExpiredRecordsFailClosed(t *testing.T) {
+	now := (&pkgtest.TestOIDCConfiguration{}).Now()
+	for _, tc := range []string{"tampered", "missing", "rotated-key", "changed-expiry", "expired", "oversized"} {
+		t.Run(tc, func(t *testing.T) {
+			au, _ := retainedFixture(t, true, 0, now.Add(time.Hour), now.Add(time.Hour))
+			s := tokenStoreSession(now, "alice")
+			require.NoError(t, au.storeRetainedTokens(context.Background(), s, now))
+			key, err := au.tokenKey(s)
+			require.NoError(t, err)
+			checkTime := now
+			switch tc {
+			case "tampered":
+				data, err := au.tokenStorage.Load(context.Background(), key)
+				require.NoError(t, err)
+				data[len(data)/2] ^= 1
+				require.NoError(t, au.tokenStorage.Store(context.Background(), key, data))
+			case "missing":
+				require.NoError(t, au.tokenStorage.Delete(context.Background(), key))
+			case "rotated-key":
+				au.Secret = strings.Repeat("r", 64)
+				au = reloadedAuthenticator(t, au)
+			case "changed-expiry":
+				data, err := au.tokenStorage.Load(context.Background(), key)
+				require.NoError(t, err)
+				s.ExpiresAt++
+				newKey, err := au.tokenKey(s)
+				require.NoError(t, err)
+				require.NoError(t, au.tokenStorage.Store(context.Background(), newKey, data))
+			case "expired":
+				checkTime = s.Expires()
+			case "oversized":
+				require.NoError(t, au.tokenStorage.Store(context.Background(), key, []byte(strings.Repeat("x", maxRetainedTokenRecordSize+1))))
+			}
+			s.AccessToken, s.IDToken = "", ""
+			require.Error(t, au.loadRetainedTokens(context.Background(), s, checkTime))
+			require.Empty(t, s.AccessToken)
+			require.Empty(t, s.IDToken)
+		})
+	}
+}
+
+func TestExpiredTokenCleanupIsBoundedAndPreservesActiveRecords(t *testing.T) {
+	now := (&pkgtest.TestOIDCConfiguration{}).Now()
+	au, _ := retainedFixture(t, true, 0, now.Add(time.Hour), now.Add(time.Hour))
+	for n := range 130 {
+		key := au.tokenNamespace() + "/" + strconv.FormatInt(now.Unix()-int64(n)-1, 10) + "/record"
+		require.NoError(t, au.tokenStorage.Store(context.Background(), key, []byte("expired")))
+	}
+	liveKey := au.tokenNamespace() + "/" + strconv.FormatInt(now.Add(time.Hour).Unix(), 10) + "/live"
+	require.NoError(t, au.tokenStorage.Store(context.Background(), liveKey, []byte("active")))
+	au.cleanupRetainedTokens(context.Background(), now)
+	keys, err := au.tokenStorage.List(context.Background(), au.tokenNamespace(), false)
+	require.NoError(t, err)
+	require.Len(t, keys, 3)
+	require.True(t, au.tokenStorage.Exists(context.Background(), liveKey))
+	au.cleanupRetainedTokens(context.Background(), now.Add(61*time.Second))
+	keys, err = au.tokenStorage.List(context.Background(), au.tokenNamespace(), false)
+	require.NoError(t, err)
+	require.Len(t, keys, 1)
+}
+
+type failingTokenStorage struct{ certmagic.Storage }
+
+func (f failingTokenStorage) Store(context.Context, string, []byte) error {
+	return errors.New("storage unavailable")
+}
+
+func TestTokenStorageFailurePreventsCookieIssuance(t *testing.T) {
+	now := (&pkgtest.TestOIDCConfiguration{}).Now()
+	au, cfg := retainedFixture(t, true, 0, now.Add(time.Hour), now.Add(time.Hour))
+	au.tokenStorage = failingTokenStorage{au.tokenStorage}
+	w := runRetainedCallback(t, au, cfg)
+	for _, c := range w.Result().Cookies() {
+		require.NotEqual(t, au.Name, c.Name)
+	}
+}
+
+func runRetainedCallback(t *testing.T, au *SessionCookieAuthenticator, cfg *retainedTokenConfiguration) *httptest.ResponseRecorder {
+	t.Helper()
+	csrf, err := au.secure.Encode(au.Name+"|state", &CSRFToken{PKCEVerifier: "v", RedirectURI: "/"})
+	require.NoError(t, err)
+	r := pkgtest.NewRequest(http.MethodGet, "/oauth2/callback?state=state&code=code", nil)
+	r.AddCookie(&http.Cookie{Name: au.Name + "|state", Value: csrf})
+	w := httptest.NewRecorder()
+	require.Error(t, au.HandleCallback(cfg, w, r))
+	return w
+}
+
+func TestFailedCookieEncodingDeletesStoredRecord(t *testing.T) {
+	now := (&pkgtest.TestOIDCConfiguration{}).Now()
+	au, cfg := retainedFixture(t, true, 0, now.Add(time.Hour), now.Add(time.Hour))
+	au.Claims = []string{"huge"}
+	cfg.userInfo = newTestUserInfo(t, `{"sub":"test","huge":"`+strings.Repeat("x", 4096)+`"}`)
+	w := runRetainedCallback(t, au, cfg)
+	for _, c := range w.Result().Cookies() {
+		require.NotEqual(t, au.Name, c.Name)
+	}
+	keys, err := au.tokenStorage.List(context.Background(), au.tokenNamespace(), true)
+	require.NoError(t, err)
+	for _, key := range keys {
+		info, err := au.tokenStorage.Stat(context.Background(), key)
+		require.NoError(t, err)
+		require.False(t, info.IsTerminal, "no orphan record should survive cookie issuance failure")
+	}
+}
