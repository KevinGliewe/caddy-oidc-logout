@@ -0,0 +1,38 @@
+package caddy_oidc
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/caddyserver/caddy/v2"
+	"github.com/caddyserver/caddy/v2/modules/caddyhttp"
+	"github.com/relvacode/caddy-oidc/authenticator"
+	"github.com/relvacode/caddy-oidc/internal/pkgtest"
+	"github.com/relvacode/caddy-oidc/session"
+	"github.com/stretchr/testify/require"
+)
+
+func TestAuthenticatedSessionContextReachesDownstream(t *testing.T) {
+	auth := &OIDCMiddleware{
+		provider: GenerateTestProvider(),
+		Policies: Ruleset{{Action: ActionAllow, Matchers: caddyhttp.MatcherSet{&MatchUser{Usernames: []string{"*"}}}}},
+	}
+	r := pkgtest.NewRequest(http.MethodGet, "/", nil)
+	r.Header.Set("Authorization", "Bearer "+pkgtest.GenerateTestJWTExpiresAt(auth.provider.Clock().Add(time.Hour)))
+	called := false
+	next := caddyhttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+		called = true
+		s, ok := r.Context().Value(SessionCtxKey).(*session.Session)
+		require.True(t, ok, "downstream middleware needs verified session context")
+		require.Equal(t, "test", s.UID)
+		require.Equal(t, authenticator.AuthMethodBearer, r.Context().Value(AuthMethodCtxKey))
+		repl := r.Context().Value(caddy.ReplacerCtxKey).(*caddy.Replacer)
+		_, leaked := repl.Get("http.auth.access_token")
+		require.False(t, leaked, "credentials must not become logging placeholders")
+		return nil
+	})
+	require.NoError(t, auth.ServeHTTP(httptest.NewRecorder(), r, next))
+	require.True(t, called)
+}
